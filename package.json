{
  "name": "draft-components",
  "version": "4.24.4",
  "description": "The React based UI components library.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./hooks/*": "./dist/hooks/*",
    "./lib/*": "./dist/lib/*",
    "./css/*": "./css/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "css"
  ],
  "scripts": {
    "prepare": "husky",
    "test": "vitest run",
    "test-watch": "vitest",
    "test-coverage": "vitest run --coverage",
    "lint": "npm run lint-js && npm run lint-css",
    "lint-js": "eslint",
    "lint-css": "stylelint 'src/**/*.css'",
    "typecheck": "tsc --project 'tsconfig.json' --noEmit",
    "prebuild": "npm run typecheck && npm run lint && npm run test",
    "build": "node scripts/build.js",
    "build-storybook": "storybook build",
    "preversion": "npm run build",
    "storybook": "storybook dev --port 6060 --no-open"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexzimakov/draft-components.git"
  },
  "keywords": [
    "react",
    "components",
    "library"
  ],
  "author": "https://github.com/alexzimakov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexzimakov/draft-components/issues"
  },
  "homepage": "https://draft-components.netlify.app",
  "peerDependencies": {
    "react": ">= 19",
    "react-dom": ">= 19"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "5.0.0",
    "autoprefixer": "10.5.6",
    "color": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-testing-library": "7.16.2",
    "glob": "13.0.6",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.5.1",
    "postcss": "8.5.28",
    "postcss-import": "17.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*.ts?(x)": "npm run lint-js",
    "*.css": "npm run lint-css"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "fsevents@2.3.3": true
  }
}
